# EGAPlugin local development environment template
# No credentials are required for lint, format, typecheck, or unit tests.
#
# The Worker fails closed until the protected-resource configuration below is
# present. Set these in `.dev.vars` for local development and as Worker secrets
# in the authorized production environment. Never commit real values.
#
# Absolute public origin, or the canonical resource URL (which takes precedence
# and must end in `/mcp`).
PUBLIC_ORIGIN=
MCP_RESOURCE=
# Read scope required on every protected MCP call (default: catalog:read).
REQUIRED_SCOPE=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user ID of the only authorized owner.
GITHUB_OWNER_ID=
# Optional comma-separated browser origins or hostnames.
ALLOWED_ORIGINS=
#
# OAUTH_KV is the KV namespace binding configured in `wrangler.jsonc`.
